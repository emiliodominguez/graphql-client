{
	"name": "@emiliodominguez/graphql-client",
	"version": "1.0.0",
	"description": "Lightweight, zero-dependency, fully typed GraphQL client: caching, live queries, React hooks, @defer/@stream, uploads, retries, middleware, persisted queries, and SSE/WebSocket subscriptions.",
	"keywords": [
		"graphql",
		"graphql-client",
		"gql",
		"client",
		"fetch",
		"cache",
		"lru-cache",
		"dedupe",
		"typescript",
		"typed",
		"zero-dependency",
		"lightweight",
		"persisted-queries",
		"apq",
		"subscriptions",
		"sse",
		"retry",
		"middleware",
		"isomorphic",
		"esm",
		"edge",
		"browser",
		"node",
		"deno",
		"bun",
		"react",
		"react-hooks",
		"suspense",
		"live-queries",
		"defer",
		"stream",
		"file-upload",
		"websocket",
		"graphql-ws",
		"subscriptions-transport",
		"svelte",
		"vue",
		"solid",
		"pagination"
	],
	"author": "Emilio Dominguez",
	"license": "MIT",
	"homepage": "https://github.com/emiliodominguez/graphql-client#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/graphql-client.git"
	},
	"bugs": {
		"url": "https://github.com/emiliodominguez/graphql-client/issues"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.js"
			},
			"require": {
				"types": "./dist/react.d.cts",
				"default": "./dist/react.cjs"
			}
		},
		"./ws": {
			"import": {
				"types": "./dist/ws.d.ts",
				"default": "./dist/ws.js"
			},
			"require": {
				"types": "./dist/ws.d.cts",
				"default": "./dist/ws.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"react": [
				"./dist/react.d.ts"
			],
			"ws": [
				"./dist/ws.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"demo": "yarn build && node examples/rick-and-morty.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"size": "node scripts/size.js",
		"prepublishOnly": "yarn verify",
		"check:exports": "attw --pack .",
		"verify": "yarn format:check && yarn typecheck && yarn coverage && yarn build && yarn size && yarn check:exports"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^5.0.4",
		"esbuild": "^0.27.7",
		"happy-dom": "^21.0.1",
		"prettier": "^3.9.10",
		"react": "^19",
		"react-dom": "^19",
		"tsup": "^8.5.1",
		"typescript": "^5.9",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"ws": "^8.22.0"
	}
}
