{
	"name": "@emiliodominguez/graphql-client",
	"version": "1.0.0",
	"description": "Lightweight, zero-dependency, fully typed GraphQL client: LRU caching, deduplication, retries, middleware, persisted queries, SSE subscriptions and typed errors.",
	"keywords": [
		"graphql",
		"graphql-client",
		"gql",
		"client",
		"fetch",
		"cache",
		"lru-cache",
		"dedupe",
		"typescript",
		"typed",
		"zero-dependency",
		"lightweight",
		"persisted-queries",
		"apq",
		"subscriptions",
		"sse",
		"retry",
		"middleware",
		"isomorphic",
		"esm",
		"edge",
		"browser",
		"node",
		"deno",
		"bun"
	],
	"author": "Emilio Dominguez",
	"license": "MIT",
	"homepage": "https://github.com/emiliodominguez/graphql-client#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/graphql-client.git"
	},
	"bugs": {
		"url": "https://github.com/emiliodominguez/graphql-client/issues"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"demo": "yarn build && node examples/rick-and-morty.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"size": "node scripts/size.js",
		"prepublishOnly": "yarn typecheck && yarn test && yarn build"
	},
	"devDependencies": {
		"@types/node": "^22",
		"@vitest/coverage-v8": "^5.0.4",
		"esbuild": "^0.27.7",
		"prettier": "^3.9.10",
		"tsup": "^8.5.1",
		"typescript": "^5.9",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	}
}
